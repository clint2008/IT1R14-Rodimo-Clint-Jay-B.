
#include <stdio.h>

int main() {
    int n, i;
    int numbers[100];
    int largest;

    printf("Enter number of elements in the array: ");
    scanf("%d", &n);

    if (n < 1 || n > 100) {
        printf("Please enter a number from 1 to 100.\n");
        return 0;
    }

    printf("Enter %d elements:\n", n);

    for (i = 0; i < n; i++) {
        scanf("%d", &numbers[i]);
    }

    largest = numbers[0];

    for (i = 1; i < n; i++) {
        if (numbers[i] > largest) {
            largest = numbers[i];
        }
    }

    printf("The largest element in the array is: %d\n", largest);

    return 0;
}
