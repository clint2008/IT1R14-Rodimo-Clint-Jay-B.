
#include <stdio.h>

int main() {

    FILE *fp;
    int n, age, i;
    char name[100], course[100];
    char line[200];

    // Create student records file
    fp = fopen("student_records.txt", "w");

    if (fp == NULL) {
        printf("Error creating file.");
        return 1;
    }

    // Ask how many students to record
    printf("How many students do you want to record? ");
    scanf("%d", &n);

    // Input and save student information
    for (i = 1; i <= n; i++) {

        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        scanf(" %[^\n]", name);

        printf("Enter Age: ");
        scanf("%d", &age);

        printf("Enter Course: ");
        scanf(" %[^\n]", course);

        fprintf(fp, "Student %d\n", i);
        fprintf(fp, "Name: %s\n", name);
        fprintf(fp, "Age: %d\n", age);
        fprintf(fp, "Course: %s\n", course);
        fprintf(fp, "--------------------\n");
    }

    // Close the file after writing
    fclose(fp);

    printf("\nStudent database successfully saved to file.\n");

    // Open file for reading
    fp = fopen("student_records.txt", "r");

    if (fp == NULL) {
        printf("Error opening file.");
        return 1;
    }

    // Display student records
    printf("\nReading Student Database:\n\n");

    while (fgets(line, sizeof(line), fp) != NULL) {
        printf("%s", line);
    }

    // Close the file
    fclose(fp);

    return 0;
}
