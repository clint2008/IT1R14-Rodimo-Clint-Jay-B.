
#include <stdio.h>
#include <time.h>

int main() {
    int choice;
    double balance = 500.00;
    double amount;

    char lastTransaction[20] = "None";
    double lastAmount = 0.00;
    char transactionDate[50] = "No transaction yet";

    time_t now;
    struct tm *localTime;

    do {
        printf("\nBSIT BANK\n");
        printf("Please Select your Transaction\n");
        printf("[1] Balance Inquiry\n");
        printf("[2] Deposit\n");
        printf("[3] Withdraw\n");
        printf("[4] Mini Statement\n");
        printf("[5] Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                printf("\nYour current balance: P%.2f\n",
                       balance);
                break;

            case 2:
                printf("Enter amount to deposit: ");
                scanf("%lf", &amount);

                if (amount > 0) {
                    balance += amount;

                    printf("P%.2f deposited successfully!\n",
                           amount);

                    snprintf(lastTransaction,
                             sizeof(lastTransaction), "Deposit");
                    lastAmount = amount;

                    now = time(NULL);
                    localTime = localtime(&now);
                    strftime(transactionDate,
                             sizeof(transactionDate),
                             "%B %d, %Y %I:%M %p",
                             localTime);
                } else {
                    printf("Invalid deposit amount!\n");
                }
                break;

            case 3:
                printf("Enter amount to withdraw: ");
                scanf("%lf", &amount);

                if (amount <= 0) {
                    printf("Invalid withdrawal amount!\n");
                } else if (balance - amount < 100.00) {
                    printf("Withdrawal denied! You must maintain "
                           "at least P100.00 in your account.\n");
                } else {
                    balance -= amount;

                    printf("You withdrew P%.2f successfully!\n",
                           amount);

                    snprintf(lastTransaction,
                             sizeof(lastTransaction), "Withdraw");
                    lastAmount = amount;

                    now = time(NULL);
                    localTime = localtime(&now);
                    strftime(transactionDate,
                             sizeof(transactionDate),
                             "%B %d, %Y %I:%M %p",
                             localTime);
                }
                break;

            case 4:
                printf("\n===== MINI STATEMENT =====\n");
                printf("Last Transaction: %s\n",
                       lastTransaction);
                printf("Amount: P%.2f\n", lastAmount);
                printf("Date and Time: %s\n",
                       transactionDate);
                printf("Current Balance: P%.2f\n", balance);
                printf("==========================\n");
                break;

            case 5:
                printf("Thank you for using BSIT BANK!\n");
                break;

            default:
                printf("Invalid choice! Please select 1-5.\n");
        }

    } while (choice != 5);

    return 0;
}
